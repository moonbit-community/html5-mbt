  let (tokens, _) = @html.tokenize("&otimesas")
  @debug.assert_eq(tokens, [
    Character('&'),
    Character('o'),
    Character('t'),
    Character('i'),
    Character('m'),
    Character('e'),
    Character('s'),
    Character('a'),
    Character('s'),
    EOF,
  ])
}

