  let doc = @html.parse("<!doctype html><script><!--<script ")
  let expected =
    #|<!DOCTYPE html>
    #|<html>
    #|  <head>
    #|    <script>
    #|      "<!--<script "
    #|  <body>
  @debug.assert_eq(doc.dump(), expected)
}

