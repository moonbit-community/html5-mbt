    #|  <head>
    #|  <body>
    #|    <select>
    #|      <plaintext>
    #|        "a<caption>b"
    #|    <table>
  @debug.assert_eq(doc.dump(), expected)
}

///|
test "html5lib/tree/tests18_1076" {
  let doc = @html.parse("<!doctype html><template><plaintext>a</template>b")
  let expected =
    #|<!DOCTYPE html>
    #|<html>
    #|  <head>
    #|    <template>
    #|      content
    #|        <plaintext>
    #|          "a</template>b"
    #|  <body>
  @debug.assert_eq(doc.dump(), expected)
}

