///|
test "html5lib/tree/tests16_934_script_on" {
  let doc = @html.parse_with_scripting(
    "<!doctype html><noscript><!--<noscript></noscript>--></noscript>",
  )
  let expected =
    #|<!DOCTYPE html>
    #|<html>
    #|  <head>
    #|    <noscript>
    #|      "<!--<noscript>"
    #|  <body>
    #|    "-->"
