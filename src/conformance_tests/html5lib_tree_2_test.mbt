  let doc = @html.parse(
    "<script><!--<script></script><script></script>- -></script>",
  )
  let expected =
    #|<html>
    #|  <head>
    #|    <script>
    #|      "<!--<script></script><script></script>- ->"
    #|  <body>
  @debug.assert_eq(doc.dump(), expected)
}

///|
test "html5lib/tree/tests16_1015" {
