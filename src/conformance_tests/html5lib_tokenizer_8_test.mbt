  let (tokens, errors) = @html.tokenize("&sscr")
  @debug.assert_eq(tokens, [
    Character('&'),
    Character('s'),
    Character('s'),
    Character('c'),
    Character('r'),
    EOF,
  ])
  @debug.assert_eq(errors.length(), 0)
}

