  let (tokens, _) = @html.tokenize("&between")
  @debug.assert_eq(tokens.map(fn(token) { token.to_string() }), [
    "Character('&')", "Character('b')", "Character('e')", "Character('t')", "Character('w')",
    "Character('e')", "Character('e')", "Character('n')", "EOF",
  ])
}

