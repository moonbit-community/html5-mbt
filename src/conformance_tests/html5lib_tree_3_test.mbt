///|
test "html5lib/tree/tests9_1586" {
  let doc = @html.parse(
    "<!DOCTYPE html><body xlink:href=foo xml:lang=en><math><mi xml:lang=en xlink:href=foo />bar</math>",
  )
  let expected =
    #|<!DOCTYPE html>
    #|<html>
    #|  <head>
    #|  <body>
    #|    xlink:href="foo"
    #|    xml:lang="en"
    #|    <math math>
    #|      <math mi>
    #|        xlink href="foo"
    #|        xml lang="en"
    #|      "bar"
  @debug.assert_eq(doc.dump(), expected)
}

///|
test "html5lib/tree/tricky01_1668" {
  let doc = @html.parse("<b><p>Bold </b> Not bold</p>\nAlso not bold.")
  let expected =
    #|<html>
    #|  <head>
    #|  <body>
    #|    <b>
    #|    <p>
    #|      <b>
    #|        "Bold "
    #|      " Not bold"
    #|    "
    #|Also not bold."
  @debug.assert_eq(doc.dump(), expected)
}

///|
test "html5lib/tree/tricky01_1669" {
  let doc = @html.parse(
    "<html>\n<font color=red><i>Italic and Red<p>Italic and Red </font> Just italic.</p> Italic only.</i> Plain\n<p>I should not be red. <font color=red>Red. <i>Italic and red.</p>\n<p>Italic and red. </i> Red.</font> I should not be red.</p>\n<b>Bold <i>Bold and italic</b> Only Italic </i> Plain",
  )
  let expected =
    #|<html>
    #|  <head>
    #|  <body>
    #|    <font>
    #|      color="red"
    #|      <i>
    #|        "Italic and Red"
    #|    <i>
    #|      <p>
    #|        <font>
    #|          color="red"
    #|          "Italic and Red "
    #|        " Just italic."
    #|      " Italic only."
    #|    " Plain
    #|"
    #|    <p>
    #|      "I should not be red. "
    #|      <font>
    #|        color="red"
    #|        "Red. "
    #|        <i>
    #|          "Italic and red."
    #|    <font>
    #|      color="red"
    #|      <i>
    #|        "
    #|"
    #|    <p>
    #|      <font>
    #|        color="red"
    #|        <i>
    #|          "Italic and red. "
    #|        " Red."
    #|      " I should not be red."
    #|    "
    #|"
    #|    <b>
    #|      "Bold "
    #|      <i>
    #|        "Bold and italic"
    #|    <i>
    #|      " Only Italic "
    #|    " Plain"
  @debug.assert_eq(doc.dump(), expected)
}

///|
test "html5lib/tree/tricky01_1670" {
  let doc = @html.parse(
    "<html><body>\n<p><font size=\"7\">First paragraph.</p>\n<p>Second paragraph.</p></font>\n<b><p><i>Bold and Italic</b> Italic</p>",
  )
  let expected =
    #|<html>
    #|  <head>
    #|  <body>
    #|    "
    #|"
    #|    <p>
    #|      <font>
    #|        size="7"
    #|        "First paragraph."
    #|    <font>
    #|      size="7"
    #|      "
    #|"
    #|      <p>
    #|        "Second paragraph."
    #|    "
    #|"
    #|    <b>
    #|    <p>
    #|      <b>
    #|        <i>
    #|          "Bold and Italic"
    #|      <i>
    #|        " Italic"
  @debug.assert_eq(doc.dump(), expected)
}

///|
test "html5lib/tree/tricky01_1671" {
  let doc = @html.parse("<html>\n<dl>\n<dt><b>Boo\n<dd>Goo?\n</dl>\n</html>")
  let expected =
    #|<html>
    #|  <head>
    #|  <body>
    #|    <dl>
    #|      "
    #|"
    #|      <dt>
    #|        <b>
    #|          "Boo
    #|"
    #|      <dd>
    #|        <b>
    #|          "Goo?
    #|"
    #|    <b>
    #|      "
    #|"
  @debug.assert_eq(doc.dump(), expected)
}

///|
test "html5lib/tree/tricky01_1672" {
  let doc = @html.parse(
    "<html><body>\n<label><a><div>Hello<div>World</div></a></label>  \n</body></html>",
  )
  let expected =
    #|<html>
    #|  <head>
    #|  <body>
    #|    "
    #|"
    #|    <label>
    #|      <a>
    #|      <div>
    #|        <a>
    #|          "Hello"
    #|          <div>
    #|            "World"
    #|        "  
    #|"
  @debug.assert_eq(doc.dump(), expected)
}

///|
test "html5lib/tree/tricky01_1673" {
  let doc = @html.parse(
    "<table><center> <font>a</center> <img> <tr><td> </td> </tr> </table>",
  )
  let expected =
    #|<html>
    #|  <head>
    #|  <body>
    #|    <center>
    #|      " "
    #|      <font>
    #|        "a"
    #|    <font>
    #|      <img>
    #|      " "
    #|    <table>
    #|      " "
    #|      <tbody>
    #|        <tr>
    #|          <td>
    #|            " "
    #|          " "
    #|        " "
  @debug.assert_eq(doc.dump(), expected)
}

///|
test "html5lib/tree/tricky01_1674" {
  let doc = @html.parse("<table><tr><p><a><p>You should see this text.")
  let expected =
    #|<html>
    #|  <head>
    #|  <body>
    #|    <p>
    #|      <a>
    #|    <p>
    #|      <a>
    #|        "You should see this text."
    #|    <table>
    #|      <tbody>
    #|        <tr>
  @debug.assert_eq(doc.dump(), expected)
}

///|
test "html5lib/tree/tricky01_1675" {
  let doc = @html.parse(
    "<TABLE>\n<TR>\n<CENTER><CENTER><TD></TD></TR><TR>\n<FONT>\n<TABLE><tr></tr></TABLE>\n</P>\n<a></font><font></a>\nThis page contains an insanely badly-nested tag sequence.",
  )
  let expected =
    #|<html>
    #|  <head>
    #|  <body>
    #|    <center>
    #|      <center>
    #|    <font>
    #|      "
    #|"
    #|    <table>
    #|      "
    #|"
    #|      <tbody>
    #|        <tr>
    #|          "
    #|"
    #|          <td>
    #|        <tr>
    #|          "
    #|"
    #|    <table>
    #|      <tbody>
    #|        <tr>
    #|    <font>
    #|      "
    #|"
    #|      <p>
    #|      "
    #|"
    #|      <a>
    #|    <a>
    #|      <font>
    #|    <font>
    #|      "
    #|This page contains an insanely badly-nested tag sequence."
  @debug.assert_eq(doc.dump(), expected)
}

///|
test "html5lib/tree/tricky01_1676" {
  let doc = @html.parse(
    "<html>\n<body>\n<b><nobr><div>This text is in a div inside a nobr</nobr>More text that should not be in the nobr, i.e., the\nnobr should have closed the div inside it implicitly. </b><pre>A pre tag outside everything else.</pre>\n</body>\n</html>",
  )
  let expected =
    #|<html>
    #|  <head>
    #|  <body>
    #|    "
    #|"
    #|    <b>
    #|      <nobr>
    #|    <div>
    #|      <b>
    #|        <nobr>
    #|          "This text is in a div inside a nobr"
    #|        "More text that should not be in the nobr, i.e., the
    #|nobr should have closed the div inside it implicitly. "
    #|      <pre>
    #|        "A pre tag outside everything else."
    #|      "
    #|
    #|"
  @debug.assert_eq(doc.dump(), expected)
}

