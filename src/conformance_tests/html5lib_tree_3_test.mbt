test "html5lib/tree/tests9_1584" {
  let doc = @html.parse(
    "<!DOCTYPE html><body xlink:href=foo xml:lang=en><math><mi xml:lang=en xlink:href=foo></mi></math>",
  )
  let expected =
    #|<!DOCTYPE html>
    #|<html>
    #|  <head>
    #|  <body>
    #|    xlink:href="foo"
    #|    xml:lang="en"
    #|    <math math>
    #|      <math mi>
    #|        xlink href="foo"
    #|        xml lang="en"
  @debug.assert_eq(doc.dump(), expected)
}

///|
test "html5lib/tree/tests9_1585" {
  let doc = @html.parse(
    "<!DOCTYPE html><body xlink:href=foo xml:lang=en><math><mi xml:lang=en xlink:href=foo /></math>",
  )
  let expected =
    #|<!DOCTYPE html>
    #|<html>
    #|  <head>
    #|  <body>
    #|    xlink:href="foo"
    #|    xml:lang="en"
    #|    <math math>
    #|      <math mi>
    #|        xlink href="foo"
    #|        xml lang="en"
  @debug.assert_eq(doc.dump(), expected)
