  let doc = @html.parse("<style> <!--> </style>x")
  let expected =
    #|<html>
    #|  <head>
    #|    <style>
    #|      " <!--> "
    #|  <body>
    #|    "x"
  @debug.assert_eq(doc.dump(), expected)
}

