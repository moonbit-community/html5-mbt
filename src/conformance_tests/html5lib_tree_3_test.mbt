///|
test "html5lib/tree/webkit01_1687" {
  let doc = @html.parse("</ tttt>")
  let expected =
    #|<!--  tttt -->
    #|<html>
    #|  <head>
    #|  <body>
  @debug.assert_eq(doc.dump(), expected)
}

///|
test "html5lib/tree/webkit01_1688" {
  let doc = @html.parse("<div FOO ><img><img></div>")
  let expected =
    #|<html>
    #|  <head>
    #|  <body>
    #|    <div>
    #|      foo=""
    #|      <img>
    #|      <img>
  @debug.assert_eq(doc.dump(), expected)
}
