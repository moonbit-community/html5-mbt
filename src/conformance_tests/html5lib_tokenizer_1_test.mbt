  @debug.assert_eq(tokens, [
    Character('&'),
    Character('D'),
    Character('o'),
    Character('w'),
    Character('n'),
    Character('A'),
    Character('r'),
    Character('r'),
    Character('o'),
    Character('w'),
    Character('U'),
    Character('p'),
    Character('A'),
    Character('r'),
    Character('r'),
    Character('o'),
    Character('w'),
    EOF,
  ])
  @debug.assert_eq(errors.length(), 0)
}

