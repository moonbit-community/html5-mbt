    StartTag(
      name="z",
      attrs=[{ name: "z", value: "  foo", }],
      self_closing=false,
    ),
    Character('b'),
    Character('a'),
    Character('r'),
    StartTag(name="z", attrs=[], self_closing=false),
    EOF,
  ])
  @debug.assert_eq(errors.length(), 0)
}

