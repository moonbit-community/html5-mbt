  let (tokens, errors) = tokenize_from_initial_state("Z", ScriptData, "")
  @debug.assert_eq(tokens, [Character('Z'), EOF])
  @debug.assert_eq(errors.length(), 0)
}

///|
test "html5lib/tokenizer-state/test3_z_6378_cdata_section_state" {
  let (tokens, errors) = tokenize_from_initial_state("Z", CDATASection, "")
  @debug.assert_eq(tokens, [Character('Z'), EOF])
  @debug.assert_eq(errors.length(), 1)
  assert_true(errors[0].code is EofInCdata)
  @debug.assert_eq(errors[0].position.line, 1)
  @debug.assert_eq(errors[0].position.column, 2)
}

